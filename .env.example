# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# Optional: For self-hosted Appwrite
# VITE_APPWRITE_ENDPOINT=https://your-appwrite-domain.com/v1

# Agora Configuration
VITE_AGORA_APP_ID=your_agora_app_id_here
# Optional: For enhanced security, use a token server
# VITE_AGORA_TOKEN_SERVER=https://your-token-server.com/api/token

# Security Configuration
# IMPORTANT: Generate a secure random key for production
# You can generate one using: openssl rand -hex 32
VITE_ENCRYPTION_KEY=your_secure_encryption_key_here

# Session Configuration
VITE_SESSION_TIMEOUT=86400000  # 24 hours in milliseconds
VITE_SESSION_IDLE_TIMEOUT=1800000  # 30 minutes in milliseconds

# Security Configuration
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=900000  # 15 minutes in milliseconds
VITE_SESSION_TIMEOUT=86400000 # 24 hours in milliseconds

# Flutterwave Configuration
VITE_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
VITE_FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
VITE_FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTae7b5250f235
# Optional: For testing, use test keys from Flutterwave dashboard
# VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# VITE_FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Security Headers (configure these on your server/CDN)
# Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.flutterwave.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://cloud.appwrite.io wss://cloud.appwrite.io https://api.flutterwave.com;
# X-Frame-Options: DENY
# X-Content-Type-Options: nosniff
# Strict-Transport-Security: max-age=31536000; includeSubDomains
# X-XSS-Protection: 1; mode=block